use crate::compiler::ast::UnaryOpKind;
use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

pub fn handle_assignexpr(
    &mut self,
    token_list: &TokenList,
    ast: &mut Ast ) -> Result<(), ParseError> {


        self.node_case(
            ast,
            token_list,
            |p, a, l| {

                let start: usize = p.curnode_start(a);
                let end: usize;
                
                match p.find_curdepth(
                    l,
                    a,
                    p.get_cur_range(a).unwrap(),
                    &mut |t: &Token| {t.kind() == TokenType::Assign}
                ) {
                    Some(i) => {
                        end = i;
                        
                        p.push_lchild(
                            a,
                            AstNodeKind::UnaryExpr(UnaryOpKind::Nil),
                            start..end
                        );
                    },
                    None => {
                        end = p.curnode_end(a);

                        p.push_rchild(
                            a,
                            AstNodeKind::CondtionExpr,
                            start..end
                        );
                        
                    },


                };

                Ok(())
            },
            |p, a, l|{

                let start: usize = p
                    .lchild_end(a)
                    .unwrap() + 1;
                
                let end: usize = p.curnode_end(a);

                if start == end {
                    return Err(ParseError::InvalidSyntax(start));
                }
                
                if start > end {
                    return Err(ParseError::UnexpectedError);
                }
                
                p.push_rchild(
                    a,
                    AstNodeKind::AssignExpr,
                    start..end
                );
                
                Ok(())
            },
            |p, a, l| {
                p.set_curnode(p.get_parent(a));
                Ok(())
            },
        )
    }
    
}
