use std::any::Any;

use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

pub fn handle_funclist(
    &mut self,
    token_list: &TokenList,
    ast: &mut Ast ) -> Result<(), ParseError> {

        self.node_case(
            ast,
            token_list,
            |p, a, l| {

                let start: usize = p.curnode_start(a);
                let end: usize;

                if start >= p.curnode_end(a) {
                    p.set_curnode(p.get_parent(a));
                    return Ok(());                    
                }
                
                let TokenType::Int = l.get(start).unwrap().kind() else {
                    return Err(ParseError::InvalidSyntax(start));
                };


              match l.match_pair_in(
                    p.get_cur_range(a).unwrap(),
                    &mut |t| {t.kind() == TokenType::LBrace},
                    &mut |t| {t.kind() == TokenType::RBrace}
                ) {
                    Some(r) => {end = r.end},
                    None => {return Err(ParseError::InvalidSyntax(start));},
                };

                p.push_lchild(
                    a,
                    AstNodeKind::Function,
                    start..end
                );
            
                Ok(())
            },
            |p, a, l| {
                let start: usize = p
                    .lchild_end(a)
                    .unwrap();

                let end: usize = p.curnode_end(a);
                
                p.push_rchild(
                    a,
                    AstNodeKind::FunctionList,
                    start..end
                );

                Ok(())
            },
            |p, a, l| {
                p.set_curnode(p.get_parent(a));
                Ok(())
            },
        )
    }
    
}
