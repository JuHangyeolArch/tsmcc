use std::ops::Range;

use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    UnaryOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

pub fn handle_unaryexpr(
    &mut self,
    token_list: &TokenList,
    ast: &mut Ast,
) -> Result<(), ParseError> {


        self.node_case(
            ast,
            token_list,
            |p, a, l| {

                let start: usize = p.curnode_start(a);
                let end: usize = p.curnode_end(a);

                if start >= end {
                    return Err(ParseError::InvalidSyntax(start));
                }
                
                let AstNodeKind::UnaryExpr(opkind) = p.curnode_kind(a) else {
                    return Err(ParseError::UnexpectedError);
                };
                
                match opkind {
                    UnaryOpKind::Nil => {
                        let kind = p.case_factor(l,start..end)?;

                        let range_factor = p.match_factor(l,a,kind.clone())?;

                        p.push_lchild(
                            a,
                            AstNodeKind::Factor(kind),
                            range_factor
                        );
                    },
                    _ => {
                        p.push_lchild(
                            a,
                            AstNodeKind::UnaryExpr(opkind),
                            start+1..end
                        );
                    },
                }

                Ok(())
            },
            |p, a, l|{
                p.set_curnode(p.get_parent(a));
                Ok(())
            },
            |p, a, l| {
                Err(ParseError::UnexpectedError)
            },
        )
    }

    pub fn case_factor(
        &mut self,
        token_list: &TokenList,
        range: Range<usize>
    ) -> Result<FactorKind, ParseError> {
            let start = range.start;

            match token_list
                .get(start)
                .unwrap()
                .kind() {
                    TokenType::Number(_) => Ok(FactorKind::Literal),
                    TokenType::Id(_) => {
                        if let TokenType::LParenth = token_list
                            .get(start)
                            .unwrap()
                            .kind() {
                                Ok(FactorKind::ProcedureCall)
                            } else {
                                Ok(FactorKind::Variable)
                            }
                        },
                    TokenType::LParenth => {
                        if let TokenType::Int = token_list
                            .get(start)
                            .unwrap()
                            .kind() {
                                Ok(FactorKind::TypeCast)
                            } else {
                                Ok(FactorKind::ParenthAssign)
                            }
                    },
                    _ => Err(ParseError::InvalidSyntax(start))
                }
        }

    pub fn match_factor(
        &mut self,
        token_list: &TokenList,
        ast: &mut Ast,
        kind: FactorKind
    ) -> Result<Range<usize>, ParseError> {

        match kind {
            FactorKind::Literal => {self.match_facsingle(ast)},
            FactorKind::Variable => {self.match_facsingle(ast)},
            FactorKind::ParenthAssign => {self.match_facparenth(token_list,ast)},
            FactorKind::TypeCast => {self.match_facparenth(token_list,ast)},
            FactorKind::ProcedureCall => {self.match_facpcall(token_list,ast)},
        }
        
    }

    pub fn match_facsingle(
        &mut self,
        ast: &mut Ast
    ) -> Result<Range<usize>, ParseError> {
        let start: usize = self.curnode_start(ast);
        let end: usize = self.curnode_end(ast);

        if TokenList::is_single(start..end) {
            return Err(ParseError::InvalidSyntax(start));
        }
        
        Ok(start..end)

    }

    pub fn match_facparenth(
        &mut self,
        token_list: &TokenList,
        ast: &mut Ast,
    ) -> Result<Range<usize>, ParseError> {
        let start: usize = self.curnode_start(ast);
        let end: usize;
        
        match token_list.pair_start_from(
            self.get_cur_range(ast).unwrap(),
            &mut |t| {t.kind() == TokenType::LParenth},
            &mut |t| {t.kind() == TokenType::RParenth}
        ) {
            Some(r) => {end = r.end},
            None => {return Err(ParseError::InvalidSyntax(start));},
        };

        Ok(start + 1..end - 1)
    }

    pub fn match_facpcall(
        &mut self,
        token_list: &TokenList,
        ast: &mut Ast,
    ) -> Result<Range<usize>, ParseError> {
        let start: usize = self.curnode_start(ast);
        let end: usize;
        
        match token_list.match_pair_in(
            self.get_cur_range(ast).unwrap(),
            &mut |t| {t.kind() == TokenType::LParenth},
            &mut |t| {t.kind() == TokenType::RParenth}
        ) {
            Some(r) => {end = r.end},
            None => {return Err(ParseError::InvalidSyntax(start));},
        };

        Ok(start..end)
    }


    
}

