use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    UnaryOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

pub fn handle_term(
    &mut self,
    token_list: &TokenList,
    ast: &mut Ast,
) -> Result<(), ParseError> {


        self.node_case(
            ast,
            token_list,
            |p, a, l| {

                let start: usize = p.curnode_start(a);
                let end: usize;

                let opkind: UnaryOpKind;
                
                match p.find_cur_fromsecond(
                    l,
                    a,
                    p.get_cur_range(a).unwrap(),
                    &mut |t: &Token| {matches!(t.kind(),TokenType::Star | TokenType::Slash)  }
                ) {
                    Some(i) => {end = i},
                    None => {end = p.curnode_end(a);},
                }
                
                match l.get(start).unwrap().kind() {
                    TokenType::Amper => {opkind = UnaryOpKind::Reference},
                    TokenType::Star => {opkind = UnaryOpKind::Dereference},
                    TokenType::Plus => {opkind = UnaryOpKind::Plus},
                    TokenType::Minus => {opkind = UnaryOpKind::Minus},
                    _ => {opkind = UnaryOpKind::Nil},
                }

                
                
                p.push_lchild(
                    a,
                    AstNodeKind::UnaryExpr(opkind),
                    start..end
                );
                    


                Ok(())
            },
            |p, a, l|{
                
                let start: usize = p
                    .lchild_end(a)
                    .unwrap() + 1;
                
                let end: usize = p.curnode_end(a);

                let opkind: MultiplicativeOpKind;

                if start == end {
                    return Err(ParseError::InvalidSyntax(start));
                }
                
                if start > end {
                    p.set_curnode(p.get_parent(a));
                    return Ok(());
                }
                
                match p.find_cur_fromsecond(
                    l,
                    a,
                    start..end,
                    &mut |t: &Token| {matches!(t.kind(),TokenType::Star | TokenType::Slash)  }
                ) {
                    Some(i) => {
                        match l.get(i)
                            .unwrap()
                            .kind() {
                                TokenType::Star => {opkind = MultiplicativeOpKind::Multiply;},
                                TokenType::Slash => {opkind = MultiplicativeOpKind::Divide;},
                                _ => {return Err(ParseError::UnexpectedError);}
                            }
                    },
                    None => {opkind = MultiplicativeOpKind::Nil;},
                }
                
                p.push_rchild(
                    a,
                    AstNodeKind::Term(opkind),
                    start..end
                );
                
                Ok(())
            },
            |p, a, l| {
                p.set_curnode(p.get_parent(a));
                Ok(())
            
            },
        )
    }
    
}

