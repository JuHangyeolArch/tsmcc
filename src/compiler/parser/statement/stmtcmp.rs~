use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

    pub fn handle_stmtcmp(
        &mut self,
        token_list: &TokenList,
        ast: &mut Ast ) -> Result<(), ParseError> {


            self.node_case(
                ast,
                token_list,
                |p, a, l| {

                    let start: usize = p.curnode_start(a);
                    let end: usize;

                    let last_dec: usize;

                    
                    match l.position_last_in(
                        p.get_cur_range(a).unwrap(),
                        &mut |t: &Token| {t.kind() == TokenType::Int},
                    ) {
                        Some(i) => {
                            last_dec = i;

                            match l.position_in(
                                last_dec..p.curnode_end(a),
                                &mut |t: &Token| {t.kind() == TokenType::Semic},                        
                            ) {
                                Some(del) => {end = del + 1}, 
                                None => {return Err(ParseError::InvalidSyntax(last_dec));}
                            };
                        },
                        None => {end = start;},
                    };

                    p.push_lchild(
                        a,
                        AstNodeKind::DeclarationList,
                        start..end
                    );
                    
                    Ok(())
                },
                |p, a, l|{
                    let start: usize = p
                        .lchild_end(a)
                        .unwrap();
                    let end: usize = p.curnode_end(a);
                    
                    p.push_rchild(
                        a,
                        AstNodeKind::DeclarationList,
                        start..end
                    );                    
                    
                    Ok(())
                },
                |p, a, l| {
                    p.set_curnode(p.get_parent(a));
                    Ok(())
                },
            )
        }
    
}
