use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

    pub fn handle_stmtif(
        &mut self,
        token_list: &TokenList,
        ast: &mut Ast ) -> Result<(), ParseError> {


            self.node_case(
                ast,
                token_list,
                |p, a, l| {
                    
                    let start: usize =  p.curnode_start(a) + 2;
                    let end: usize;

                    if let Some(r)  = l.pair_start_from(
                        start - 1..p.curnode_end(a),
                        &mut |t| {t.kind() == TokenType::LParenth},
                        &mut |t| {t.kind() == TokenType::RParenth}
                    ) {
                        end = r.end -1;
                    } else {
                        return Err(ParseError::InvalidSyntax(start - 1));
                    };
                    
                    p.push_lchild(
                        a,
                        AstNodeKind::AssginExpr,
                        start..end
                    );                
                
                    Ok(())
                },
                |p, a, l|{

                    let start: usize =  p.lchild_end(a)
                        .unwrap() + 1;
                    let end: usize;

                    if let Some(r)  = l.pair_start_from(
                        start - 1..p.curnode_end(a),
                        &mut |t| {t.kind() == TokenType::LBrace},
                        &mut |t| {t.kind() == TokenType::RBrace}
                    ) {
                        end = r.end - 1;
                    } else {
                        return Err(ParseError::InvalidSyntax(start - 1));
                    };
                    
                    p.push_lchild(
                        a,
                        AstNodeKind::Statement(StatementKind::Compound),
                        start..end
                    );
                
                    Ok(())
                },
                |p, a, l| {
                    p.set_curnode(p.get_parent(a));
                    Ok(())
                },
            )
        }
    
}
