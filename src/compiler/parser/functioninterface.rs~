use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

pub fn handle_fi(
    &mut self,
    token_list: &TokenList,
    ast: &mut Ast ) -> Result<(), ParseError> {


        self.node_case(
            ast,
            token_list,
            |p, a, l| {

                let start: usize = p.curnode_start(a);
                let end: usize;
                match l.match_pair_in(
                    p.get_cur_range(a).unwrap(),
                    &mut |t| {t.kind() == TokenType::LParenth},
                    &mut |t| {t.kind() == TokenType::RParenth}
                ) {
                    Some(r) => {end = r.start;},
                    None => {return Err(ParseError::InvalidSyntax(start));},
                };
                
                p.push_lchild(
                    a,
                    AstNodeKind::Declarator,
                    start..end
                );

                Ok(())
            },
            |p, a, l|{

                let start: usize = p
                    .lchild_end(a)
                    .unwrap() + 1;
                
                let end: usize = p.curnode_end(a) - 1;
                

                p.push_rchild(
                    a,
                    AstNodeKind::ParameterList,
                    start..end
                );
                
                Ok(())
            },
            |p, a, l| {
                p.set_curnode(p.get_parent(a));
                Ok(())
            },
        )
    }
    
}
