use crate::compiler::parser::Parser;
use crate::compiler::parser::ParseError;
use crate::compiler::ProducedBy;
use super::SpanInfo;
use super::CompileError;
use crate::compiler::token::{Token,TokenList,TokenType};
use crate::compiler::ast::{
    Ast,
    AstNode,
    NodeID,
    AstNodeKind,
    AdditiveOpKind,
    MultiplicativeOpKind,
    StatementKind,
    FactorKind,
    BasicValueKind,
};



impl Parser {

pub fn handle_addexpr(
    &mut self,
    token_list: &TokenList,
    ast: &mut Ast,
) -> Result<(), ParseError> {


        self.node_case(
            ast,
            token_list,
            |p, a, l| {

                let start: usize = p.curnode_start(a);
                let end: usize;

                let fac_end: usize;
                

                let opkind: MultiplicativeOpKind;

                match p.find_curdepth(
                    l,
                    a,
                    p.get_cur_range(a).unwrap(),
                    &mut |t: &Token| {matches!(t.kind(),TokenType::Id(_) | TokenType::Number(_) | TokenType::LParenth)}
                ) {
                    Some(i) => {end = i},
                    None => {return Err(ParseError::InvalidSyntax(start));},
                }

                

                
                match p.find_curdepth(
                    l,
                    a,
                    p.get_cur_range(a).unwrap(),
                    &mut |t: &Token| {matches!(t.kind(),TokenType::Plus | TokenType::Minus)  }
                ) {
                    Some(i) => {end = i},
                    None => {end = p.curnode_end(a);},
                }



                match p.find_curdepth(
                    l,
                    a,
                    p.get_cur_range(a).unwrap(),
                    &mut |t: &Token| {matches!(t.kind(),TokenType::Id(_) | TokenType::Number(_) | TokenType::LParenth)  }
                ) {
                    Some(i) => {fac_end = i},
                    None => {return Err(ParseError::InvalidSyntax(start));},
                }                

                if fac_end < end {
                    match l.get(fac_end).unwrap().kind() {
                        TokenType::Star => {opkind = MultiplicativeOpKind::Multiply},
                        TokenType::Slash => {opkind = MultiplicativeOpKind::Divide;},
                        _ => {return Err(ParseError::InvalidSyntax(fac_end+1));}
                    }
                }
                else {
                    opkind = MultiplicativeOpKind::Nil;
                }                
                
                p.push_lchild(
                    a,
                    AstNodeKind::Term(opkind),
                    start..end
                );
                    


                Ok(())
            },
            |p, a, l|{
                
                let start: usize = p
                    .lchild_end(a)
                    .unwrap() + 1;
                
                let end: usize = p.curnode_end(a);

                let opkind: AdditiveOpKind;

                if start == end {
                    return Err(ParseError::InvalidSyntax(start));
                }
                
                if start > end {
                    p.set_curnode(p.get_parent(a));
                    return Ok(());
                }
                
                match p.find_cur_fromsecond(
                    l,
                    a,
                    start..end,
                    &mut |t: &Token| {matches!(t.kind(),TokenType::Plus | TokenType::Minus)  }
                ) {
                    Some(i) => {
                        match l.get(i)
                            .unwrap()
                            .kind() {
                                TokenType::Plus => {opkind = AdditiveOpKind::Add;},
                                TokenType::Minus => {opkind = AdditiveOpKind::Substract;},
                                _ => {return Err(ParseError::UnexpectedError);}
                            }
                    },
                    None => {opkind = AdditiveOpKind::Nil;},
                }
                
                p.push_rchild(
                    a,
                    AstNodeKind::AdditiveExpr(opkind),
                    start..end
                );
                
                Ok(())
            },
            |p, a, l| {
                p.set_curnode(p.get_parent(a));
                Ok(())
            
            },
        )
    }
    
}
