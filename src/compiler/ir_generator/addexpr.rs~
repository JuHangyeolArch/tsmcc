use crate::compiler::ir_generator::term;

pub fn ir_addexpr(
    ast: &Ast,
    func_table: &FuncTable,
    id: NodeID,
    entry: usize,
    iloc: &mut IlocProgram,
    reg_count: usize,    
) -> Result<(usize),CsError> {

    let node = ast.get(id).unwrap();
    let lchild = node.get_lchild().unwrap();

    let left_reg = term::ir_term(ast,func_table,lchild,entry,iloc,reg_count)?;
    
    let Some(rchild) = node.get_rchild() else {
        return Ok(left_reg);
    };

    let right_reg = ir_addexpr(ast,func_table,rchild,entry,iloc,left_reg+1)?;
    let result_reg = if left_reg + 1 < right_reg {
        left_reg + 1
    } else {
        right_reg + 1
    };

    let ir_func = iloc
        .get_mut_bypos(entry)
        .unwrap();

    ir_func.update_regmax(result_reg);
    ir_func.add_line(
        IlocInstruction::Add{
            source1: Register(left_reg),
            source2: Register(right_reg),
            target: Register(result_reg),
        },
        None,
        id
    );
    
    Ok((result_reg))
   
}
